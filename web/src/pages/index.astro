---
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';

import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

import Distribution from '../components/Distribution.astro';
import Honours from '../components/Honours.astro';
import Ledger from '../components/Ledger.astro';

// Read the published figures at build time. The site is static: no query engine, no
// database, no request-time work.
//
// Resolved from the working directory rather than import.meta.url: this frontmatter is
// bundled into dist/.prerender/ before it runs, so a URL relative to the module would
// resolve against the build output instead of the source tree.
const dataPath = resolve(process.cwd(), '../data/public/site/headline.json');
const data = JSON.parse(readFileSync(dataPath, 'utf-8'));

const { timeline, latestYear, minPartySize } = data;
const parties = data.parties ?? [];
const states = data.states ?? [];
const byMoney = data.byMoney ?? [];
const byAge = data.byAge ?? [];
const assetBands = data.assetBands ?? [];
const ageBands = data.ageBands ?? [];
const honours = data.honours ?? [];

const latest = timeline[timeline.length - 1];
const earliest = timeline[0];

const richest = assetBands[assetBands.length - 1];
const poorest = assetBands[0];
const youngest = ageBands[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gormint Goons — what the Lok Sabha declared about itself, 2004–2024</title>
    <meta
      name="description"
      content={`Criminal cases, money and age in the Lok Sabha, taken from candidates' own sworn affidavits. Members declaring a pending case rose from ${earliest.pct}% in ${earliest.year} to ${latest.pct}% in ${latest.year}.`}
    />
  </head>

  <body>
    <div class="shell">
      <header class="masthead">
        <p class="masthead__stamp">Record of declarations</p>
        <h1 class="masthead__title">Gormint&nbsp;Goons</h1>
        <p class="masthead__standfirst">
          Everything below was sworn to by the candidates themselves, on affidavits filed with
          the Election Commission between {earliest.year} and {latest.year}. Nobody is accused
          of anything here that they did not first declare in writing.
        </p>
        <hr class="masthead__rule" />
      </header>

      <Honours honours={honours} year={latestYear} minPartySize={minPartySize} />

      {/* ---------------- criminal cases ---------------- */}

      <section class="section" id="cases">
        <div class="section__head">
          <p class="caption">Field 1 — Criminal cases</p>
          <h2 class="section__title">The charge sheet</h2>
        </div>

        <p class="section__standfirst">
          The share of members arriving at the Lok Sabha with a pending criminal case has
          risen at every single general election since {earliest.year}. Nobody planned this.
          It simply keeps happening.
        </p>

        <div class="cells" style="margin-top:2rem">
          {
            timeline.map((row, i) => (
              <article class={`cell${row.year === latestYear ? ' cell--latest' : ''}`}>
                <p class="cell__year">
                  <span>{row.year}</span>
                  {row.year === latestYear && <span class="cell__mark">Latest</span>}
                </p>
                <div class="frac">
                  <p class="frac__value">
                    {row.pct}
                    <sup>%</sup>
                  </p>
                  <div class="frac__rule" style={`animation-delay:${140 + i * 110}ms`} />
                  <p class="frac__of">
                    <b>{row.withCases}</b> of {row.analysed} elected
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        {
          latest.contestedPct != null && (
            <p class="gap">
              A pending case is not a handicap. In {latest.year} it was more than twice as
              common among the winners ({latest.pct.toFixed(1)}%) as among the{' '}
              {latest.contested.toLocaleString('en-IN')} people who merely ran ({latest.contestedPct.toFixed(1)}%).
            </p>
          )
        }

        <section class="ledger">
          <Ledger
            rows={parties}
            dimension="party"
            metric="pct"
            metricLabel="Share with a case"
            format="percent"
            percentTrack={true}
            title="By party"
            caption={`${latestYear} · members elected`}
          />
        </section>

        <section class="ledger">
          <Ledger
            rows={states}
            dimension="state"
            metric="pct"
            metricLabel="Share with a case"
            format="percent"
            percentTrack={true}
            title="By state"
            caption={`${latestYear} · members elected`}
            note="A state's figure counts members it returned to the Lok Sabha across all parties. It says nothing about who governs the state."
          />
        </section>

        <p class="record__note">
          A declared case is one the member disclosed as pending against them when they filed.
          It is not a conviction, and it covers cases arising from protest alongside serious
          alleged offences. By-elections are excluded. {earliest.year} rests on{' '}
          {earliest.analysed} seats rather than the full 543, because {543 - earliest.analysed}
          {' '}of its constituency records name no winner upstream.
        </p>
      </section>

      {/* ---------------- money ---------------- */}

      <section class="section" id="money">
        <div class="section__head">
          <p class="caption">Field 2 — Declared assets</p>
          <h2 class="section__title">The price of a seat</h2>
        </div>

        <p class="section__standfirst">
          Nobody is required to be rich to stand for the Lok Sabha. It simply helps
          enormously.
        </p>

        <div class="split" style="margin-top:2rem">
          <div>
            <Distribution bands={assetBands} />
          </div>
          <div>
            {
              poorest && richest && (
                <p class="gap" style="margin-top:0">
                  {poorest.contestedShare.toFixed(1)}% of candidates declared under ₹1 lakh.
                  Among members elected: <b>{poorest.wonShare.toFixed(1)}%</b>. Meanwhile{' '}
                  {richest.wonShare.toFixed(1)}% of the chamber declared over ₹100 crore, against{' '}
                  {richest.contestedShare.toFixed(1)}% of those who stood.
                </p>
              )
            }
            <p class="record__note">
              Bands are logarithmic because declared wealth spans seven orders of magnitude;
              linear buckets would put almost everyone in the first one. Assets are
              self-declared and unaudited.
            </p>
          </div>
        </div>

        <section class="ledger">
          <Ledger
            rows={byMoney}
            dimension="party"
            metric="medianAssets"
            metricLabel="Median assets"
            format="rupees"
            title="Richest benches"
            caption={`${latestYear} · median declared assets of members elected`}
            note="Median, not mean, so a single very wealthy member does not carry a whole party."
          />
        </section>
      </section>

      {/* ---------------- age ---------------- */}

      <section class="section" id="age">
        <div class="section__head">
          <p class="caption">Field 3 — Age</p>
          <h2 class="section__title">The waiting room</h2>
        </div>

        <p class="section__standfirst">
          India is one of the youngest countries on earth. Its parliament is not, and the gap
          widens every election.
        </p>

        <div class="split" style="margin-top:2rem">
          <div>
            <Distribution bands={ageBands} />
          </div>
          <div>
            {
              youngest && (
                <p class="gap" style="margin-top:0">
                  Under-35s are {youngest.contestedShare.toFixed(1)}% of candidates and{' '}
                  <b>{youngest.wonShare.toFixed(1)}%</b> of the chamber. The median member
                  elected has aged from {timeline[0].medianAge} in {earliest.year} to{' '}
                  {latest.medianAge} today.
                </p>
              )
            }
            <p class="record__note">
              Age is self-declared. An age below 25 cannot be real — nobody younger may sit in
              the Lok Sabha — so those values are read as undeclared rather than as zero,
              which is how the source writes them.
            </p>
          </div>
        </div>

        <section class="ledger">
          <Ledger
            rows={byAge}
            dimension="party"
            metric="medianAge"
            metricLabel="Median age"
            format="years"
            title="Oldest benches"
            caption={`${latestYear} · median age of members elected`}
          />
        </section>
      </section>

      <footer class="colophon">
        <div class="colophon__grid">
          <div>
            <h3>Source</h3>
            <p>
              Candidate affidavits filed with the Election Commission of India, compiled and
              published by <strong>ADR and National Election Watch</strong> at
              <a href="https://myneta.info">myneta.info</a>. This site re-presents their work;
              it does not replace it.
            </p>
          </div>
          <div>
            <h3>How the jokes work</h3>
            <p>
              The commentary is ours; the numbers are not. Every award is the top of one
              published column, with its denominator printed underneath — there is
              <strong> no combined score</strong> and nothing weighted.
            </p>
          </div>
          <div>
            <h3>Not yet covered</h3>
            <p>
              Central infrastructure delivery and parliamentary attendance. Project data,
              when it lands, will never be broken down by party — a delayed highway cannot be
              pinned on one government.
            </p>
          </div>
          <div>
            <h3>Method</h3>
            <p>
              Every figure traces to a stored document with its checksum and retrieval date.
              Denominators, caveats and known gaps in
              <a
                href="https://github.com/udingpudding/gormint-goons/blob/main/docs/methodology.md"
                >methodology.md</a
              >.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

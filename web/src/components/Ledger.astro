---
/*
  A ranked table with an inline meter.

  The meter's track is the full range of the metric across the rows shown, so bar length is
  comparable within one table and never implies a percentage of something it isn't. Where the
  metric is already a percentage the track is 0–100, because that is its real range.
*/
const {
  rows,
  dimension,
  metric,
  metricLabel,
  format,
  caption,
  title,
  note,
  percentTrack = false,
} = Astro.props;

const peak = Math.max(...rows.map((r) => r[metric] ?? 0), 1);
const width = (value) =>
  value == null ? 0 : percentTrack ? value : (value / peak) * 100;

function rupees(value) {
  if (!value) return '—';
  if (value >= 1e7) return `₹${(value / 1e7).toFixed(2)} Cr`;
  if (value >= 1e5) return `₹${(value / 1e5).toFixed(1)} L`;
  return `₹${value.toLocaleString('en-IN')}`;
}

const render = (value) => {
  if (value == null) return '—';
  if (format === 'rupees') return rupees(value);
  if (format === 'percent') return `${value.toFixed(1)}%`;
  return `${value}`;
};
---

<div class="ledger__head">
  <h3 class="ledger__title">{title}</h3>
  <p class="caption">{caption}</p>
</div>

<div class="scroller">
  <table>
    <thead>
      <tr>
        <th scope="col">{dimension === 'party' ? 'Party' : 'State'}</th>
        <th scope="col">{metricLabel}</th>
        <th class="meter" aria-hidden="true"></th>
        <th scope="col">Members</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td class="party">{row[dimension]}</td>
            <td>{render(row[metric])}</td>
            <td class="meter" title={`${row[dimension]}: ${render(row[metric])}`}>
              <div class="meter__track" aria-hidden="true">
                <div class="meter__fill" style={`width:${width(row[metric])}%`} />
              </div>
            </td>
            <td class="of">{row.analysed}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{note && <p class="ledger__note">{note}</p>}
